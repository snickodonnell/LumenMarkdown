<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Lumen Markdown"
           Manufacturer="Lumen Markdown"
           Version="$(var.AppVersion)"
           UpgradeCode="7E93485E-852F-4CD4-A8B5-42075D88CD78"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Lumen Markdown is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="LumenIcon" SourceFile="$(var.AssetsDir)\LumenMarkdown.ico" />
    <Property Id="ARPPRODUCTICON" Value="LumenIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Lumen Markdown">
          <Component Id="ApplicationFiles" Guid="1C526655-0C28-47BD-93A4-8B31C3308EA1">
            <File Id="LumenExe" Source="$(var.PublishDir)\LumenMarkdown.exe">
              <Shortcut Id="StartMenuShortcut"
                        Directory="ProgramMenuFolder"
                        Name="Lumen Markdown"
                        Description="A lightweight native Markdown reader"
                        WorkingDirectory="INSTALLFOLDER"
                        Advertise="no" />
            </File>
            <RegistryValue Root="HKCU" Key="Software\LumenMarkdown\Components" Name="Application" Value="1" Type="integer" KeyPath="yes" />
            <RegistryValue Root="HKCU" Key="Software\Classes\LumenMarkdown.File\DefaultIcon" Value="&quot;[#LumenExe]&quot;,0" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\Classes\LumenMarkdown.File\shell\open\command" Value="&quot;[#LumenExe]&quot; &quot;%1&quot;" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Applications\LumenMarkdown.exe\shell\open\command" Value="&quot;[#LumenExe]&quot; &quot;%1&quot;" Type="string" />
            <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
            <RemoveFolder Id="RemoveLocalProgramsFolderIfEmpty" Directory="LocalProgramsFolder" On="uninstall" />
          </Component>
          <Component Id="ApplicationDll" Guid="2D61FE43-0F9B-4B83-BCB1-19D57F579B1B">
            <File Id="LumenDll" Source="$(var.PublishDir)\LumenMarkdown.dll" />
            <RegistryValue Root="HKCU" Key="Software\LumenMarkdown\Components" Name="ApplicationDll" Value="1" Type="integer" KeyPath="yes" />
          </Component>
          <Component Id="CoreDll" Guid="3E732FF9-AFAE-4B2B-8F73-44A4999B1DC2">
            <File Id="LumenCoreDll" Source="$(var.PublishDir)\LumenMarkdown.Core.dll" />
            <RegistryValue Root="HKCU" Key="Software\LumenMarkdown\Components" Name="CoreDll" Value="1" Type="integer" KeyPath="yes" />
          </Component>
          <Component Id="DepsFile" Guid="4F843A48-BF94-489E-B0E9-EA537A7CE0D3">
            <File Id="LumenDeps" Source="$(var.PublishDir)\LumenMarkdown.deps.json" />
            <RegistryValue Root="HKCU" Key="Software\LumenMarkdown\Components" Name="Deps" Value="1" Type="integer" KeyPath="yes" />
          </Component>
          <Component Id="RuntimeConfigFile" Guid="5A954B59-C0A5-49AF-A1FA-FB648B8DF1E4">
            <File Id="LumenRuntimeConfig" Source="$(var.PublishDir)\LumenMarkdown.runtimeconfig.json" />
            <RegistryValue Root="HKCU" Key="Software\LumenMarkdown\Components" Name="RuntimeConfig" Value="1" Type="integer" KeyPath="yes" />
          </Component>

          <Component Id="FileAssociations" Guid="*">
            <RegistryValue Root="HKCU" Key="Software\Classes\.md" Value="LumenMarkdown.File" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.markdown" Value="LumenMarkdown.File" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\Classes\LumenMarkdown.File" Value="Markdown Document" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Applications\LumenMarkdown.exe\SupportedTypes" Name=".md" Value="" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Applications\LumenMarkdown.exe\SupportedTypes" Name=".markdown" Value="" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\LumenMarkdown\Capabilities" Name="ApplicationName" Value="Lumen Markdown" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\LumenMarkdown\Capabilities" Name="ApplicationDescription" Value="A lightweight native Markdown reader" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\LumenMarkdown\Capabilities\FileAssociations" Name=".md" Value="LumenMarkdown.File" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\LumenMarkdown\Capabilities\FileAssociations" Name=".markdown" Value="LumenMarkdown.File" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\RegisteredApplications" Name="Lumen Markdown" Value="Software\LumenMarkdown\Capabilities" Type="string" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Lumen Markdown" Level="1">
      <ComponentRef Id="ApplicationFiles" />
      <ComponentRef Id="ApplicationDll" />
      <ComponentRef Id="CoreDll" />
      <ComponentRef Id="DepsFile" />
      <ComponentRef Id="RuntimeConfigFile" />
      <ComponentRef Id="FileAssociations" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
  </Package>
</Wix>
