<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>LumenMarkdownSetup-1.3.1</OutputName>
    <OutputPath>..\installer-output\</OutputPath>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressIces>ICE91</SuppressIces>
    <DefineConstants>PublishDir=$(MSBuildProjectDirectory)\..\dist;AssetsDir=$(MSBuildProjectDirectory)\..\src\LumenMarkdown\Assets;AppVersion=1.3.1</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
