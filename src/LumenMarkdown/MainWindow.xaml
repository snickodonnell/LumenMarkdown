<Window x:Class="LumenMarkdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LumenMarkdown"
        Title="Lumen Markdown" Width="1050" Height="760" MinWidth="520" MinHeight="360"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15"
        WindowStyle="None" ResizeMode="CanResize" AllowDrop="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="HeaderButton" TargetType="Button">
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.65" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
      <Setter Property="Width" Value="42" /><Setter Property="Height" Value="34" /><Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="14" />
    </Style>
  </Window.Resources>

  <Border x:Name="WindowFrame" BorderBrush="{DynamicResource SubtleBrush}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource PageBrush}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="32" /></Grid.RowDefinitions>

      <!-- The title bar is a native caption (WindowChrome): Windows handles dragging, drag-to-restore from maximized, Snap, double-click and the system menu. -->
      <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0">
            <Image Source="Assets/LumenMarkdown-128.png" Width="28" Height="28" />
          </Border>
          <Button x:Name="FileMenuButton" Style="{StaticResource HeaderButton}" Click="FileMenuButton_Click" Content="File  ▾" ToolTip="File commands" Margin="0,0,2,0">
            <Button.ContextMenu>
              <ContextMenu x:Name="FileContextMenu" Opened="FileContextMenu_Opened"
                           Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                           BorderBrush="{DynamicResource SubtleBrush}" BorderThickness="1" Padding="0">
                <ContextMenu.Template>
                  <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="4"
                            SnapsToDevicePixels="True">
                      <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                  </ControlTemplate>
                </ContextMenu.Template>
                <ContextMenu.Resources>
                  <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="MinWidth" Value="250" />
                    <Setter Property="Height" Value="31" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                          <Grid x:Name="MenuRoot" Background="{TemplateBinding Background}" MinWidth="{TemplateBinding MinWidth}"
                                Height="{TemplateBinding Height}" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MenuHighlight" Grid.ColumnSpan="3" Background="Transparent" CornerRadius="5" />
                            <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True"
                                              Margin="12,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                       Margin="8,0,6,0" VerticalAlignment="Center" />
                            <Path x:Name="SubmenuArrow" Grid.Column="2" Data="M 0 0 L 4 4 L 0 8 Z"
                                  Fill="{DynamicResource MutedTextBrush}" Width="4" Height="8"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right" PlacementTarget="{Binding ElementName=MenuRoot}" HorizontalOffset="-2" VerticalOffset="-4"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBrush}"
                                      BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="260" SnapsToDevicePixels="True">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="480">
                                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                              </Border>
                            </Popup>
                          </Grid>
                          <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader"><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuHighlight" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="MenuHighlight" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                  <Style TargetType="Separator">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                          <Border Height="1" Background="{DynamicResource SubtleBrush}" Margin="9,4" />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ContextMenu.Resources>
                <MenuItem Header="Open…" InputGestureText="Ctrl+O" Click="Open_Click" />
                <MenuItem x:Name="OpenRecentMenu" Header="Open Recent" />
                <Separator />
                <MenuItem x:Name="SaveAsMenu" Header="Save As…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                <MenuItem x:Name="ReloadMenu" Header="Reload from Disk" InputGestureText="Ctrl+R" Click="Reload_Click" />
                <Separator />
                <MenuItem x:Name="RevealMenu" Header="Reveal in Explorer" InputGestureText="Ctrl+Shift+E" Click="Reveal_Click" />
                <MenuItem x:Name="CopyPathMenu" Header="Copy File Path" Click="CopyPath_Click" />
                <MenuItem x:Name="CopyRawMenu" Header="Copy Raw Markdown" InputGestureText="Ctrl+A" Click="CopyRaw_Click" />
                <Separator />
                <MenuItem x:Name="CloseTabMenu" Header="Close Tab" InputGestureText="Ctrl+W" Click="CloseActiveTab_Click" />
                <MenuItem x:Name="CloseAllMenu" Header="Close All Tabs" InputGestureText="Ctrl+Shift+W" Click="CloseAllTabs_Click" />
                <Separator />
                <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="Exit_Click" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Style="{StaticResource HeaderButton}" Click="Open_Click" ToolTip="Open Markdown (Ctrl+O)">
            <StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="17" Margin="0,-1,5,0" /><TextBlock Text="Open" /></StackPanel>
          </Button>
        </StackPanel>
        <TextBlock x:Name="FileTitle" Grid.Column="1" Text="Lumen Markdown" FontWeight="SemiBold" FontSize="14"
                   Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,7,0" VerticalAlignment="Center">
          <Button x:Name="OutlineButton" Style="{StaticResource HeaderButton}" Click="Outline_Click" ToolTip="Document outline (Ctrl+Shift+O)" FontSize="18" Content="☷" />
          <Button x:Name="ThemeButton" Style="{StaticResource HeaderButton}" Click="Theme_Click" ToolTip="Toggle theme (Ctrl+T)" FontSize="16" Content="☾" />
          <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" Content="—" ToolTip="Minimize" />
          <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Click="Maximize_Click" Content="□" ToolTip="Maximize" />
          <Button Style="{StaticResource WindowButton}" Click="Close_Click" Content="×" FontSize="18" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <TabControl x:Name="DocumentTabs" Background="Transparent" BorderThickness="0" SelectionChanged="DocumentTabs_SelectionChanged">
          <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="39" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBrush}" BorderThickness="0,1,0,1">
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="True">
                    <TabPanel IsItemsHost="True" Margin="12,4,12,0" />
                  </ScrollViewer>
                </Border>
                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
              </Grid>
            </ControlTemplate>
          </TabControl.Template>
          <TabControl.ItemContainerStyle>
            <Style TargetType="TabItem">
              <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="7,7,0,0" Padding="11,5,7,6" Margin="0,0,3,0">
                      <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PageBrush}" />
                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource SubtleBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </TabControl.ItemContainerStyle>
          <TabControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" MaxWidth="220" MouseDown="TabHeader_MouseDown">
                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="170" />
                <Button Content="×" Click="CloseTab_Click" ToolTip="Close tab (Ctrl+W)" Margin="8,0,0,0" Width="19" Height="19" Padding="0" FontSize="14"
                        Foreground="{DynamicResource MutedTextBrush}" Background="Transparent" BorderThickness="0" Cursor="Hand" />
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate><DataTemplate><local:DocumentView /></DataTemplate></TabControl.ContentTemplate>
        </TabControl>

        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
          <Border Width="58" Height="58" CornerRadius="17" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBrush}" BorderThickness="1" Margin="0,0,0,18">
            <Image Source="Assets/LumenMarkdown-128.png" Width="58" Height="58" />
          </Border>
          <TextBlock Text="A quiet place for Markdown" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Drop a .md file here, or press Ctrl+O" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" Margin="16,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
        <TextBlock Grid.Column="1" Text="Ctrl+O  Open    Ctrl+A  Copy raw    Ctrl+W  Close    Ctrl+T  Theme" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>

      <Border x:Name="FindPanel" Grid.RowSpan="3" Panel.ZIndex="90" Visibility="Collapsed"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,58,18,0"
              Padding="8" CornerRadius="9" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource SubtleBrush}" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <TextBox x:Name="FindBox" Width="220" Height="30" Padding="9,4" VerticalContentAlignment="Center"
                   Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
                   BorderBrush="{DynamicResource SubtleBrush}" BorderThickness="1"
                   TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown" />
          <TextBlock x:Name="FindCountText" Text="0 results" MinWidth="62" Margin="9,0,4,0"
                     Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" TextAlignment="Center" />
          <Button Style="{StaticResource HeaderButton}" Content="↑" ToolTip="Previous (Shift+Enter)" Click="FindPrevious_Click" Padding="7,4" />
          <Button Style="{StaticResource HeaderButton}" Content="↓" ToolTip="Next (Enter)" Click="FindNext_Click" Padding="7,4" />
          <Button Style="{StaticResource HeaderButton}" Content="×" ToolTip="Close (Esc)" Click="FindClose_Click" Padding="7,4" />
        </StackPanel>
      </Border>

      <Popup x:Name="OutlinePopup" PlacementTarget="{Binding ElementName=OutlineButton}" Placement="Bottom"
             AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
        <Border Width="330" MaxHeight="520" Margin="0,5,0,0" Padding="8" CornerRadius="9"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBrush}" BorderThickness="1">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Document outline" FontWeight="SemiBold" Margin="8,5,8,9" />
            <TextBlock x:Name="OutlineEmptyText" Text="No headings in this document" Visibility="Collapsed"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="8,5,8,10" />
            <ListBox x:Name="OutlineList" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource TextBrush}" PreviewMouseLeftButtonUp="OutlineList_Click"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" Padding="8,6" /></DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="BorderThickness" Value="0" />
                  <Setter Property="Background" Value="Transparent" />
                  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger></Style.Triggers>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
          </DockPanel>
        </Border>
      </Popup>

      <Border x:Name="CopyToast" Grid.RowSpan="3" Panel.ZIndex="100" Visibility="Collapsed" Opacity="0"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,20,20,48"
              Padding="14,9" CornerRadius="9" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource SubtleBrush}" BorderThickness="1" IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="✓" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,8,0" />
          <TextBlock x:Name="CopyToastText" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
