<Application x:Class="LumenMarkdown.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <SolidColorBrush x:Key="PageBrush" Color="#F7F7F5" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#ECECEA" />
    <SolidColorBrush x:Key="TextBrush" Color="#202123" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6F7074" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#DEDEDA" />
    <SolidColorBrush x:Key="CodeBrush" Color="#EEEEEA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#10A37F" />
    <Style x:Key="SlimVerticalScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="MinWidth" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Width="8" Margin="0,3,2,3" Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" IsTabStop="False" Opacity="0" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="28" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbShape" Width="4" CornerRadius="2"
                                HorizontalAlignment="Center" Background="{DynamicResource MutedTextBrush}" Opacity="0.38" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbShape" Property="Opacity" Value="0.72" />
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbShape" Property="Opacity" Value="0.9" />
                            <Setter TargetName="ThumbShape" Property="Background" Value="{DynamicResource AccentBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" IsTabStop="False" Opacity="0" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <!-- The style is applied implicitly to every ScrollBar in the document list, so horizontal bars need their own template. -->
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="Height" Value="8" />
          <Setter Property="MinHeight" Value="8" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Height="8" Margin="3,0,3,2" Background="Transparent">
                  <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Focusable="False" IsTabStop="False" Opacity="0" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb MinWidth="28" Focusable="False">
                        <Thumb.Template>
                          <ControlTemplate TargetType="Thumb">
                            <Border x:Name="ThumbShape" Height="4" CornerRadius="2"
                                    VerticalAlignment="Center" Background="{DynamicResource MutedTextBrush}" Opacity="0.38" />
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbShape" Property="Opacity" Value="0.72" />
                              </Trigger>
                              <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbShape" Property="Opacity" Value="0.9" />
                                <Setter TargetName="ThumbShape" Property="Background" Value="{DynamicResource AccentBrush}" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Focusable="False" IsTabStop="False" Opacity="0" />
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
